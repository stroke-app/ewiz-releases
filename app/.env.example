# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real secrets.

# Base URL of the site (used by auth + links)
VITE_BASE_URL="http://localhost:3000"

# Postgres connection string
DATABASE_URL="postgres://user:password@localhost:5432/battlify"

# Better Auth — generate with: pnpm auth:secret
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dodo Payments (https://app.dodopayments.com)
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_SECRET=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_BATTLIFY_PRODUCT_ID=""

# License signing key (Ed25519 private key, PEM/base64)
LICENSE_SIGNING_PRIVATE_KEY=""

# Read-only GitHub token for the stroke-app/ewiz releases API (optional;
# raises the rate limit the changelog and download pages fetch under)
GITHUB_RELEASES_TOKEN=""

# --- PostHog analytics ---
# Public project key: safe to expose in the client bundle, so it's fine to commit.
VITE_PUBLIC_POSTHOG_KEY="phc_vC3Zpv7J3G7QrrJaayAMmwYoABnC8KZ8URmxbmLrvaXa"
VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Personal API key is for local tooling only (PostHog CLI/wizard) — NOT read by
# the app at runtime. Keep it out of the client and out of production. Set it in
# your local .env only if a tool needs it:
# POSTHOG_PERSONAL_API_KEY=""
